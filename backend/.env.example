# Backend environment variables — copy to .env and fill in values

# Database (SQLite for local dev, PostgreSQL URL for production)
DATABASE_URL=sqlite:///./otterpia.db

# Polling interval in minutes (default: 15)
POLL_INTERVAL_MINUTES=15

# Per-source fetch timeout in seconds
CONNECTOR_FETCH_TIMEOUT_SECONDS=8

# Maximum source connectors fetched simultaneously (lower this on small instances)
CONNECTOR_CONCURRENCY=1

# Maximum active watch terms processed by one poll run (0 = all terms)
POLL_TERMS_PER_RUN=1

# Disable push alerts for owner-scoped terms this old when their APNs device no longer exists
ORPHANED_NOTIFICATION_GRACE_MINUTES=60

# Clear an accumulated pending-notification count once it has sat behind a missing APNs device this long
PENDING_NOTIFICATION_STALE_AFTER_DAYS=7

# Admin API token — required for shared/deployed backends
ADMIN_API_TOKEN=

# Local-development escape hatch. Never enable this on a shared/deployed backend.
ALLOW_UNAUTHENTICATED_ADMIN=true

# CORS — comma-separated list of allowed origins (leave empty to allow all)
CORS_ALLOW_ORIGINS=

# YouTube Data API v3 key — enables reliable video dates and ordered results
YOUTUBE_API_KEY=

# X (Twitter) Bearer Token — enables Twitter/X search
TWITTER_BEARER_TOKEN=

# r.jina.ai reader API key — without it, Google News fallback fetches share
# jina's anonymous quota, which Google periodically rate-limits/blocks
# ("AbuseAlleviationError") independent of this app's own traffic. Get a key
# at https://jina.ai/reader (free authenticated tier) to avoid that.
JINA_API_KEY=

# Apple Push Notification Service (APNs) — enables push notifications on iOS
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_PRIVATE_KEY_PATH=
APNS_TOPIC=com.otterpia.oshireader.plus
APNS_USE_SANDBOX=false
BACKEND_PUBLIC_URL=https://oshireader.onrender.com
