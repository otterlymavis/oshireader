# Backend environment variables — copy to .env and fill in values

# Database (SQLite for local dev, PostgreSQL URL for production)
DATABASE_URL=sqlite:///./otterpia.db

# Polling interval in minutes (default: 15)
POLL_INTERVAL_MINUTES=15

# Per-source fetch timeout in seconds
CONNECTOR_FETCH_TIMEOUT_SECONDS=25

# Admin API token — required for shared/deployed backends
ADMIN_API_TOKEN=

# Local-development escape hatch. Never enable this on a shared/deployed backend.
ALLOW_UNAUTHENTICATED_ADMIN=true

# CORS — comma-separated list of allowed origins (leave empty to allow all)
CORS_ALLOW_ORIGINS=

# YouTube Data API v3 key — enables reliable video dates and ordered results
YOUTUBE_API_KEY=

# X (Twitter) Bearer Token — enables Twitter/X search
TWITTER_BEARER_TOKEN=

# Apple Push Notification Service (APNs) — enables push notifications on iOS
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_PRIVATE_KEY_PATH=
APNS_TOPIC=com.otterpia.oshireader.plus
APNS_USE_SANDBOX=false
BACKEND_PUBLIC_URL=https://oshireader.onrender.com
