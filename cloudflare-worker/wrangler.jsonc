{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oshireader-feed-poller",
  "main": "src/index.js",
  "compatibility_date": "2026-06-20",
  "observability": {
    "enabled": true
  },
  "vars": {
    "BACKEND_URL": "https://oshireader.onrender.com",
    "POLL_RETRIES": "1",
    "POLL_RETRY_DELAY_MS": "5000",
    "STALE_AFTER_MINUTES": "360",
    "ACTIVE_POLL_TIMEOUT_MINUTES": "30",
    "MIN_POLL_INTERVAL_MINUTES": "120"
  },
  "triggers": {
    "crons": [
      "0 */2 * * *",
      "0 1/2 * * *",
      "4-59/10 * * * *"
    ]
  }
}
