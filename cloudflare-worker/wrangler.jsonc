{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oshireader-feed-poller",
  "main": "src/index.js",
  "compatibility_date": "2026-06-20",
  "observability": {
    "enabled": true
  },
  "vars": {
    "BACKEND_URL": "https://oshireader.onrender.com",
    "POLL_RETRIES": "1",
    "POLL_RETRY_DELAY_MS": "5000",
    "STALE_AFTER_MINUTES": "240",
    "MIN_POLL_INTERVAL_MINUTES": "170"
  },
  "triggers": {
    "crons": [
      "0 */3 * * *"
    ]
  }
}
