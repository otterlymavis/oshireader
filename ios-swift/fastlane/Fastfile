default_platform(:ios)

platform :ios do
  private_lane :app_store_connect_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_KEY_PATH")
    )
  end

  desc "Upload maintenance metadata for the legacy OshiReader+ app"
  lane :upload_metadata do
    deliver(
      api_key: app_store_connect_key,
      app_identifier: "com.otterpia.oshireader.plus",
      metadata_path: "./fastlane/metadata",
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      automatic_release: false
    )
  end

  desc "Download maintenance metadata for the legacy OshiReader+ app"
  lane :download_metadata do
    deliver(
      api_key: app_store_connect_key,
      app_identifier: "com.otterpia.oshireader.plus",
      metadata_path: "./fastlane/metadata",
      run_precheck_before_submit: false
    )
  end
end
